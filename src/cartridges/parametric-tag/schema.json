{
  "productSlug": "parametric-tag",
  "displayName": "Parametric Tag & Keyring Forge",
  "partSlots": ["base_plate", "text_inlay"],
  "parameters": [
    {
      "id": "p1",
      "key": "shape",
      "label": "Shape Profile",
      "type": "select",
      "display": "segmented",
      "group": "Text & Letters",
      "order": 1,
      "description": "Outer 2D silhouette of the tag base (rounded rectangle, circular medallion, or sharp 90° rectangle).",
      "options": [
        { "value": "rounded", "label": "Rounded Rect" },
        { "value": "circle", "label": "Round (Circle)" },
        { "value": "rectangle", "label": "Rectangle" }
      ],
      "default": "rounded"
    },
    {
      "id": "p2",
      "key": "text",
      "label": "Text Content",
      "type": "text",
      "group": "Text & Letters",
      "order": 2,
      "description": "Primary line of extruded 3D lettering.",
      "placeholder": "e.g. KEYS, LAB 04, EXIT",
      "validationPattern": "^.{1,32}$",
      "maxLength": 32,
      "default": "KEYS"
    },
    {
      "id": "p3",
      "key": "fontSize",
      "label": "Font Size",
      "type": "slider",
      "group": "Text & Letters",
      "order": 3,
      "description": "Cap height in millimeters for the primary text line.",
      "min": 4.0,
      "max": 18.0,
      "step": 0.2,
      "unit": "mm",
      "default": 6.8
    },
    {
      "id": "p4",
      "key": "fontVariant",
      "label": "Font Weight",
      "type": "select",
      "display": "segmented",
      "group": "Text & Letters",
      "order": 4,
      "description": "Helvetica typeface stroke weight for crisp FDM nozzle extrusion.",
      "options": [
        { "value": "bold", "label": "Bold" },
        { "value": "regular", "label": "Regular" }
      ],
      "default": "bold"
    },
    {
      "id": "p5",
      "key": "letterSpacing",
      "label": "Distance Between Letters",
      "type": "slider",
      "group": "Text & Letters",
      "order": 5,
      "description": "Additional horizontal kerning gap between adjacent glyphs.",
      "min": 0,
      "max": 8.0,
      "step": 0.1,
      "unit": "mm",
      "default": 0.4
    },
    {
      "id": "p6",
      "key": "letterFillet",
      "label": "Letter Edge Fillet",
      "type": "slider",
      "group": "Text & Letters",
      "order": 6,
      "description": "Soft chamfer/bevel along the top edges of raised 3D letters.",
      "min": 0,
      "max": 1.5,
      "step": 0.05,
      "unit": "mm",
      "visibleWhen": {
        "param": "p23",
        "equals": "raised"
      },
      "default": 0
    },
    {
      "id": "p7",
      "key": "isUppercase",
      "label": "Force Uppercase",
      "type": "boolean",
      "group": "Text & Letters",
      "order": 7,
      "description": "Automatically convert all input characters to uppercase capitals.",
      "default": true
    },
    {
      "id": "p8",
      "key": "hasSecondLine",
      "label": "Second Subtitle Line",
      "type": "boolean",
      "group": "Text & Letters",
      "order": 8,
      "description": "Enable a secondary line of text stacked centered beneath the primary line.",
      "default": false
    },
    {
      "id": "p9",
      "key": "textLine2",
      "label": "Subtitle Text",
      "type": "text",
      "group": "Text & Letters",
      "order": 9,
      "description": "Optional secondary text line (room number, phone number, or zone code).",
      "placeholder": "e.g. ROOM 101, STUDIO",
      "validationPattern": "^.{0,32}$",
      "maxLength": 32,
      "visibleWhen": {
        "param": "p8",
        "equals": true
      },
      "default": "STUDIO"
    },
    {
      "id": "p10",
      "key": "fontSize2",
      "label": "Subtitle Size",
      "type": "slider",
      "group": "Text & Letters",
      "order": 10,
      "description": "Cap height in millimeters for the secondary subtitle line.",
      "min": 3.0,
      "max": 12.0,
      "step": 0.2,
      "unit": "mm",
      "visibleWhen": {
        "param": "p8",
        "equals": true
      },
      "default": 4.5
    },
    {
      "id": "p11",
      "key": "lineSpacing",
      "label": "Line Spacing",
      "type": "slider",
      "group": "Text & Letters",
      "order": 11,
      "description": "Vertical clearance gap between the primary line and subtitle line.",
      "min": 0.5,
      "max": 10.0,
      "step": 0.1,
      "unit": "mm",
      "visibleWhen": {
        "param": "p8",
        "equals": true
      },
      "default": 1.8
    },
    {
      "id": "p12",
      "key": "baseThickness",
      "label": "Plate Thickness",
      "type": "slider",
      "group": "Outline & Base Fillets",
      "order": 12,
      "description": "Total Z-axis height of the solid backing tag.",
      "min": 1.6,
      "max": 5.5,
      "step": 0.2,
      "unit": "mm",
      "default": 2.4
    },
    {
      "id": "p13",
      "key": "padding",
      "label": "Border Margin (Padding)",
      "type": "slider",
      "group": "Outline & Base Fillets",
      "order": 13,
      "description": "Minimum border clearance surrounding the text bounding box.",
      "min": 1.5,
      "max": 12.0,
      "step": 0.2,
      "unit": "mm",
      "default": 3.0
    },
    {
      "id": "p14",
      "key": "filletRadius",
      "label": "Outline Corner Fillet",
      "type": "slider",
      "group": "Outline & Base Fillets",
      "order": 14,
      "description": "Corner arc radius applied to rounded rectangle tag profiles.",
      "min": 1.0,
      "max": 12.0,
      "step": 0.2,
      "unit": "mm",
      "visibleWhen": {
        "param": "p1",
        "notEquals": "circle"
      },
      "default": 3.5
    },
    {
      "id": "p15",
      "key": "edgeBevel",
      "label": "Outline Edge Bevel",
      "type": "slider",
      "group": "Outline & Base Fillets",
      "order": 15,
      "description": "Chamfered top and bottom perimeter edge bevel for comfortable handling.",
      "min": 0.0,
      "max": 1.2,
      "step": 0.05,
      "unit": "mm",
      "visibleWhen": {
        "param": "p23",
        "notEquals": "cutout"
      },
      "default": 0.4
    },
    {
      "id": "p16",
      "key": "minBaseLength",
      "label": "Min Base Length",
      "type": "slider",
      "group": "Outline & Base Fillets",
      "order": 16,
      "description": "Enforces a minimum overall X-axis tag length (0 disables floor clamping).",
      "min": 0,
      "max": 120.0,
      "step": 1.0,
      "unit": "mm",
      "default": 25.0
    },
    {
      "id": "p17",
      "key": "maxBaseLength",
      "label": "Max Base Length",
      "type": "slider",
      "group": "Outline & Base Fillets",
      "order": 17,
      "description": "Caps overall X-axis tag length (0 disables upper clamping).",
      "min": 0,
      "max": 200.0,
      "step": 1.0,
      "unit": "mm",
      "default": 80.0
    },
    {
      "id": "p18",
      "key": "holePlacement",
      "label": "Hole Placement",
      "type": "select",
      "display": "segmented",
      "group": "Mounting Holes",
      "order": 18,
      "description": "Side of the tag where the keyring or zip-tie mounting holes are positioned.",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "both-ends", "label": "Both" },
        { "value": "none", "label": "None" }
      ],
      "default": "left"
    },
    {
      "id": "p19",
      "key": "holeCount",
      "label": "Hole Count",
      "type": "select",
      "display": "segmented",
      "group": "Mounting Holes",
      "order": 19,
      "description": "Single centered keyring hole or symmetrical dual zip-tie holes.",
      "options": [
        { "value": 1, "label": "1 Center Hole" },
        { "value": 2, "label": "2 Symmetrical Holes" }
      ],
      "visibleWhen": {
        "param": "p18",
        "notEquals": "none"
      },
      "default": 1
    },
    {
      "id": "p20",
      "key": "holeDiameter",
      "label": "Hole Diameter",
      "type": "slider",
      "group": "Mounting Holes",
      "order": 20,
      "description": "Inner bore diameter of each through-hole.",
      "min": 2.5,
      "max": 6.5,
      "step": 0.2,
      "unit": "mm",
      "visibleWhen": {
        "param": "p18",
        "notEquals": "none"
      },
      "default": 4.0
    },
    {
      "id": "p21",
      "key": "holeEdgeMargin",
      "label": "Hole Edge Margin",
      "type": "slider",
      "group": "Mounting Holes",
      "order": 21,
      "description": "Minimum wall thickness around the hole perimeter and clearance from text.",
      "min": 1.5,
      "max": 10.0,
      "step": 0.1,
      "unit": "mm",
      "visibleWhen": {
        "param": "p18",
        "notEquals": "none"
      },
      "default": 3.5
    },
    {
      "id": "p22",
      "key": "holeSymmetricalSpacing",
      "label": "Dual Hole Spacing",
      "type": "slider",
      "group": "Mounting Holes",
      "order": 22,
      "description": "Center-to-center distance between paired holes when 2 holes are selected.",
      "min": 6.0,
      "max": 60.0,
      "step": 0.5,
      "unit": "mm",
      "visibleWhen": {
        "param": "p19",
        "equals": 2
      },
      "default": 16.0
    },
    {
      "id": "p23",
      "key": "tagStyle",
      "label": "3D Relief Style",
      "type": "select",
      "display": "segmented",
      "group": "3D Profile & Style",
      "order": 23,
      "description": "Raised two-color relief, flush carved inlay, or through-punched stencil cutout.",
      "options": [
        { "value": "raised", "label": "Raised" },
        { "value": "curved", "label": "Carved" },
        { "value": "cutout", "label": "Cutout" }
      ],
      "default": "raised"
    },
    {
      "id": "p24",
      "key": "reliefHeight",
      "label": "Relief Depth",
      "type": "slider",
      "group": "3D Profile & Style",
      "order": 24,
      "description": "Extrusion height above base in Raised mode, or inlay pocket depth in Carved mode.",
      "min": 0.6,
      "max": 6.0,
      "step": 0.2,
      "unit": "mm",
      "visibleWhen": {
        "param": "p23",
        "notEquals": "cutout"
      },
      "default": 1.2
    },
    {
      "id": "p25",
      "key": "stencilGap",
      "label": "Stencil Bridge Gap",
      "type": "slider",
      "group": "3D Profile & Style",
      "order": 25,
      "description": "Width of retention bridges connecting enclosed letter counters (e.g. O, A, P, R).",
      "min": 0.6,
      "max": 5.0,
      "step": 0.1,
      "unit": "mm",
      "visibleWhen": {
        "param": "p23",
        "equals": "cutout"
      },
      "default": 1.0
    },
    {
      "id": "p26",
      "key": "stencilBridges",
      "label": "Stencil Bridges",
      "type": "boolean",
      "group": "3D Profile & Style",
      "order": 26,
      "description": "Automatically preserve floating inner islands in letters like A, B, D, O, P, Q, R.",
      "visibleWhen": {
        "param": "p23",
        "equals": "cutout"
      },
      "default": true
    },
    {
      "id": "p27",
      "key": "centerTextInBase",
      "label": "Center Text in Base",
      "type": "boolean",
      "group": "3D Profile & Style",
      "order": 27,
      "description": "Symmetrically balance the base outline on the opposite side of single-edge holes.",
      "default": true
    },
    {
      "id": "p28",
      "key": "csgSolidUnion",
      "label": "Single-Body CSG Union",
      "type": "boolean",
      "group": "3D Profile & Style",
      "order": 28,
      "description": "Fuse raised letters and base plate into one single-color manifold mesh (disable for dual-color AMS).",
      "visibleWhen": {
        "param": "p23",
        "equals": "raised"
      },
      "default": false
    }
  ],
  "tiers": {
    "personal": {
      "formats": ["STL", "3MF"],
      "licenseFile": "LICENSE.txt"
    },
    "merchant": {
      "formats": ["STL", "3MF"],
      "licenseFile": "LICENSE.txt"
    }
  }
}
